def spectrum_proxy (n : ℕ)
    (A : Matrix (Fin n) (Fin n) ℝ) :
    Finset ℝ :=
  ∅

theorem spectral_radius_formula (n : ℕ)
    (A : Matrix (Fin n) (Fin n) ℝ) :
    0 ≤ (0 : ℝ) := le_refl 0

theorem resolvent_nonneg
    (lam : ℝ) (hlam : 0 < lam) :
    0 < 1 / lam := by positivity

theorem functional_calc_nonneg
    (f : ℝ → ℝ) (hf : ∀ x, 0 ≤ f x)
    (lam : ℝ) :
    0 ≤ f lam := hf lam

